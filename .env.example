# Environment profile layout:
#
#   .env.local              ← used by `pnpm dev` + `pnpm db:migrate` (LOCAL profile)
#   .env.qa                 ← committed safe defaults used by `pnpm dev:qa` (QA profile)
#   .env.qa.local           ← optional gitignored real AI credentials for QA
#   .env.preview.local      ← used by `pnpm db:migrate:preview`      (PREVIEW profile)
#   .env.production.local   ← used by `pnpm db:migrate:prod` only   (PRODUCTION profile)
#
# Production runtime (Vercel) reads env vars from the Vercel dashboard, not
# from any file in this repo.

# ─── LOCAL profile (.env.local) ──────────────────────────────────────────────
# Local dev uses a SQLite file. Leave Turso vars empty.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
LOCAL_DB_PATH="packages/db/local.db"

BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Any Google account may sign up by default. Set this emergency kill switch to
# "true" only when new account creation must be paused; existing users can
# still sign in.
ANKIFY_DISABLE_SIGNUP="false"
# After publishing the Chrome extension, optionally restrict browser CORS to
# its stable Web Store id. Unpacked extensions do not need this in local dev.
ANKIFY_EXTENSION_ORIGINS=""

# Optional override for the app's "Get the extension" buttons. The default is
# ankify's stable Chrome Web Store listing.
# NEXT_PUBLIC_EXTENSION_INSTALL_URL="https://chromewebstore.google.com/detail/ankify/gcldkcaidjnkaagngppblefddapdpaeb"

# 32+ random bytes (base64 / hex / plain). Local DB has its own settings, so
# this can differ from the prod secret without breaking decryption.
AI_KEY_ENCRYPTION_SECRET="generate-another-long-random-string"

# ─── QA profile (.env.qa + optional .env.qa.local) ───────────────────────────────────
# `.env.qa` is committed and already isolates DB/auth/encryption for local QA.
# Add only these optional values to `.env.qa.local` to reuse a real provider:
# ANKIFY_QA_AI_PROVIDER="openai"
# ANKIFY_QA_AI_MODEL="gpt-5-mini"
# ANKIFY_QA_AI_REASONING_MODE="fast"
# ANKIFY_QA_AI_API_KEY="<provider-key>"

# ─── PREVIEW profile (.env.preview.local) ───────────────────────────────────
# Use a separate Turso database and secrets. Never point Preview at Production.
#
# TURSO_DATABASE_URL="libsql://<your-preview-db>.turso.io"
# TURSO_AUTH_TOKEN="<preview database token>"
#
# The Vercel Preview environment must additionally set:
# ANKIFY_DEPLOYMENT_ENV="preview"
# BETTER_AUTH_SECRET="<preview-only secret>"
# BETTER_AUTH_URL="https://<stable-preview-branch-domain>"
# GOOGLE_CLIENT_ID="<Google OAuth client with the preview callback registered>"
# GOOGLE_CLIENT_SECRET="<Google OAuth secret>"
# ANKIFY_DISABLE_SIGNUP="true" # recommended for private Preview deployments
# ANKIFY_EXTENSION_ORIGINS="chrome-extension://<32-character-web-store-id>"
# AI_KEY_ENCRYPTION_SECRET="<preview-only encryption secret>"

# ─── PRODUCTION profile (.env.production.local) ──────────────────────────────
# Only needed locally so you can run prod migrations: `pnpm db:migrate:prod`.
# Do NOT commit. Keep these in sync with the Vercel env dashboard.
#
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<from `turso db tokens create`>"
# ANKIFY_DEPLOYMENT_ENV="production" # Vercel only; not needed by the DB CLI
# BETTER_AUTH_SECRET="<same secret as Vercel>"
# BETTER_AUTH_URL="https://ankify-pi.vercel.app"
# GOOGLE_CLIENT_ID="<same as Vercel>"
# GOOGLE_CLIENT_SECRET="<same as Vercel>"
# ANKIFY_DISABLE_SIGNUP="false"
# ANKIFY_EXTENSION_ORIGINS="chrome-extension://<32-character-web-store-id>"
# AI_KEY_ENCRYPTION_SECRET="<MUST match Vercel — losing this orphans every stored AI key>"
#
# Chrome extension release builds use this build-time value. It is not needed
# by the Vercel runtime:
# ANKIFY_EXTENSION_API_ORIGIN="https://ankify-pi.vercel.app"
