{
  "name": "ankify",
  "private": true,
  "version": "0.1.0",
  "description": "Personal LeetCode/CS spaced-repetition app with FSRS-6, AI MCQs, and a Chrome extension",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm db:migrate && pnpm --filter @ankify/web dev",
    "dev:web": "pnpm db:migrate && pnpm --filter @ankify/web dev",
    "dev:all": "pnpm db:migrate && pnpm --parallel --filter @ankify/web --filter @ankify/extension dev",
    "dev:ext": "pnpm --filter @ankify/extension dev",
    "dev:qa": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs",
    "dev:qa:all": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --extension",
    "qa:reset": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --reset-only",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm extension:check-manifest && pnpm audit --prod --audit-level=high --ignore-registry-errors",
    "extension:build:unpacked": "pnpm --filter @ankify/extension build:unpacked",
    "extension:check-manifest": "node scripts/check-extension-manifest.mjs",
    "db:generate": "pnpm --filter @ankify/db generate",
    "db:migrate": "pnpm --filter @ankify/db migrate",
    "db:migrate:qa": "pnpm --filter @ankify/db migrate:qa",
    "db:migrate:preview": "pnpm --filter @ankify/db migrate:preview",
    "db:migrate:prod": "pnpm --filter @ankify/db migrate:prod",
    "db:studio": "pnpm --filter @ankify/db studio",
    "db:studio:qa": "pnpm --filter @ankify/db studio:qa",
    "db:studio:preview": "pnpm --filter @ankify/db studio:preview",
    "db:studio:prod": "pnpm --filter @ankify/db studio:prod",
    "db:backup": "pnpm --filter @ankify/db backup",
    "db:release": "pnpm db:backup && pnpm db:migrate:prod"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.9",
      "jsondiffpatch": "0.7.2",
      "minimatch@10": "10.2.6",
      "postcss": "8.5.26",
      "sharp": "0.35.0",
      "shell-quote": "1.10.0",
      "ws": "8.21.1"
    }
  }
}
